# Production environment for docker-compose.prod.yml.
#   cp .env.prod.example .env.prod    (never commit .env.prod)
#
# The two secrets below are MANDATORY. Generate strong values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs every session/API token. The app refuses to boot in production
# with the default value or anything under 32 bytes.
JWT_SECRET=

# Postgres password (also interpolated into DATABASE_URL by the compose file).
POSTGRES_PASSWORD=

# --------------------------------------------------------------------
# Optional
# --------------------------------------------------------------------

# Where the API publishes on the host. Default 80 (plain-HTTP mode).
# With the https profile, uncomment so Caddy owns ports 80/443:
# API_BIND=127.0.0.1:8080

# Domain for the https profile (Caddy provisions certificates for it).
# DOMAIN=jobsched.example.com

# Plain-HTTP deployment reached by bare IP? The dashboard session cookie
# is HTTPS-only in production by default, so login would not stick.
# Uncomment ONLY if you accept running the dashboard over plain HTTP:
# COOKIE_SECURE=false

# Jobs each worker container runs concurrently (see README benchmarks).
# WORKER_CONCURRENCY=4

# Enables real AI-generated dead-letter failure summaries (otherwise a
# built-in rule-based fallback is used -- no key required).
# ANTHROPIC_API_KEY=

# Zone used to DISPLAY dashboard timestamps (IANA name). Storage stays UTC.
# Set to UTC to show raw stored times.
DASHBOARD_TIMEZONE=Asia/Kolkata
