ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://jobsched:jobsched@localhost:5432/jobsched
SYNC_DATABASE_URL=postgresql+psycopg2://jobsched:jobsched@localhost:5432/jobsched
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional: enables real AI-generated dead-letter failure summaries via the
# Anthropic API. Leave unset to use the built-in rule-based fallback instead
# (no key required to demo the rest of the app).
ANTHROPIC_API_KEY=
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_HEARTBEAT_TIMEOUT_SECONDS=20.0
WORKER_DEFAULT_CONCURRENCY=4
SCHEDULER_POLL_INTERVAL_SECONDS=1.0
